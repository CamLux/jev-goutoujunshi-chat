# 统一编码与行尾：项目要求 UTF-8，且需跨 Windows / Linux / macOS 协作。
# 不加这段，Windows 上的 Git 可能把 .kt / .md 里的中文按本地代码页处理，导致乱码。

# 默认：交给 Git 自动判断文本，提交时统一为 LF
* text=auto eol=lf

# 源码与文档一律按 UTF-8 文本处理
*.kt      text diff=kotlin
*.kts     text diff=kotlin
*.java    text
*.xml     text
*.md      text
*.json    text
*.properties text
*.pro     text
*.yaml    text
*.yml     text
*.py      text

# Gradle wrapper 脚本需要可执行位，且行尾必须是 LF（CRLF 会导致 Linux/macOS 无法执行）
gradlew        text eol=lf
gradlew.bat    text eol=crlf
*.sh           text eol=lf
*.command      text eol=lf

# 二进制文件不做任何转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.apk   binary
*.jar   binary
*.zip   binary
*.so    binary
*.ttf   binary
*.otf   binary

# 语言统计时视为生成物/文档，不计入代码
site/**     linguist-documentation
FUSION.md   linguist-documentation
